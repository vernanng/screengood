#!/bin/bash
# Reels-Scroll.command - (shared code in fb-reels-lib.sh). SHIFT + mouse wheel = Reels on TV.
#   SHIFT + wheel DOWN = NEXT Reel | SHIFT + wheel UP = PREV Reel (works anywhere on Mac)
#   SHIFT + middle-click (or SHIFT+right-click) = pause/resume VIDEO via tap center (keyevent 85 ignored by FB)
# Needs ONE-TIME allow: macOS Input Monitoring for Terminal (this file opens it for you).
DIR="$(cd "$(dirname "$0")" && pwd)"  # wherever this file lives (~/projects/screen-mirror today)
LIB="$DIR/fb-reels-lib.sh"
if [ ! -f "$LIB" ]; then echo "Missing $LIB - keep fb-reels-lib.sh next to this file."; read -p "Press Enter to close: " _; exit 1; fi
. "$LIB"  # shared: resolve_tools, ensure_pynput, pick_serial, auto_connect, check_trust, connect_phone
resolve_tools
IPFILE="$DIR/fb-reels-tv-ip.txt"
PYFILE="$DIR/fb-reels-scroll.py"
SERIAL=""

write_python() {
  cat > "$PYFILE" <<'PYEOF'
#!/usr/bin/env python3
# AUTO-GENERATED by Reels-Scroll.command (write_python) on every run - edit there, not here.
"""S25 FE Shift+wheel listener. DOWN=NEXT, UP=PREV. No phone touch."""
import time, subprocess, sys, os, threading, shutil
ADB = os.environ.get("ADB_BIN") or shutil.which("adb") or "/opt/homebrew/bin/adb"
SERIAL = os.environ.get("ADB_SERIAL", "")
PW = int(os.environ.get("PHONE_W", "1080"))  # launchers export real `wm size`; default = S25 FE
PH = int(os.environ.get("PHONE_H", "2340"))
CX = PW // 2
SWIPE_BOT = int(round(PH * 1700 / 2340))  # known-good S25 FE points, scaled to any screen
SWIPE_TOP = int(round(PH * 700 / 2340))
TAP_Y = int(round(PH * 1150 / 2340))
BASE = [ADB] + (["-s", SERIAL] if SERIAL else []) + ["shell", "input", "swipe"]
NEXT_CMD = BASE + [str(CX), str(SWIPE_BOT), str(CX), str(SWIPE_TOP), "400"]  # finger UP = next
PREV_CMD = BASE + [str(CX), str(SWIPE_TOP), str(CX), str(SWIPE_BOT), "400"]  # finger DOWN = prev
VIDEO_CMD = [ADB] + (["-s", SERIAL] if SERIAL else []) + ["shell", "input", "tap", str(CX), str(TAP_Y)]  # tap center = Reels video pause/resume (keyevent 85 is ignored by FB player)
COOLDOWN = 0.9
INVERT = False
last_fire = 0.0
shift_held = False
PIXEL_THRESHOLD = 6.0  # light scroll: ~6px of wheel movement is enough for NEXT/PREV
acc_dx = acc_dy = 0.0
acc_last = 0.0
_bounds_cache = []
_bounds_at = 0.0
_tap = None

def scrcpy_bounds():
    global _bounds_cache, _bounds_at
    now = time.time()
    if now - _bounds_at < 0.5:
        return _bounds_cache
    _bounds_at = now
    try:
        from Quartz import CGWindowListCopyWindowInfo, kCGWindowListOptionOnScreenOnly, kCGWindowListExcludeDesktopElements, kCGNullWindowID
        wins = CGWindowListCopyWindowInfo(kCGWindowListOptionOnScreenOnly | kCGWindowListExcludeDesktopElements, kCGNullWindowID)
        out = []
        for w in wins:
            if "scrcpy" not in (w.get("kCGWindowOwnerName") or "").lower():
                continue
            b = w.get("kCGWindowBounds") or {}
            out.append((float(b.get("X", 0)), float(b.get("Y", 0)), float(b.get("Width", 0)), float(b.get("Height", 0))))
        _bounds_cache = out
    except Exception:
        _bounds_cache = []
    return _bounds_cache

def scrcpy_at(x, y):
    """True when the Mac cursor (x, y) is over the scrcpy mirror window."""
    for bx, by, bw, bh in scrcpy_bounds():
        if bx <= x <= bx + bw and by <= y <= by + bh:
            return True
    return False

def decide(dx, dy):
    if abs(dx) < 1e-9 and abs(dy) < 1e-9:
        return None
    if abs(dx) > abs(dy):
        is_next = (dx < 0)
    else:
        is_next = (dy < 0)
    if INVERT:
        is_next = not is_next
    return "NEXT" if is_next else "PREV"

def selftest():
    cases = [(0,-1,"NEXT"),(0,1,"PREV"),(-1,0,"NEXT"),(1,0,"PREV"),(0,0,None)]
    ok = True
    for dx, dy, exp in cases:
        got = decide(dx, dy)
        s = "PASS" if got == exp else "FAIL"
        if got != exp: ok = False
        print(f"  dx={dx:+} dy={dy:+} -> {got} (expect {exp}) [{s}]", flush=True)
    # suffix indexes only: a leading "-s SERIAL" pair must not shift the coords (regression)
    assert NEXT_CMD[-5:-1] == [str(CX), str(SWIPE_BOT), str(CX), str(SWIPE_TOP)], "NEXT must be bottom->top"
    assert PREV_CMD[-5:-1] == [str(CX), str(SWIPE_TOP), str(CX), str(SWIPE_BOT)], "PREV must be top->bottom"
    assert SWIPE_BOT > SWIPE_TOP > 0 and 0 < TAP_Y < PH and 0 < CX < PW, "points must be on screen"
    fake = [ADB, "-s", "FAKE:1", "shell", "input", "swipe"] + NEXT_CMD[-5:]
    sok = (fake[-5:-1] == NEXT_CMD[-5:-1])
    print(f"  coords survive -s SERIAL prefix [{('PASS' if sok else 'FAIL')}]", flush=True)
    if not sok: ok = False
    print(f"  swipe NEXT={SWIPE_BOT}->{SWIPE_TOP} [PASS]", flush=True)
    print(f"  swipe PREV={SWIPE_TOP}->{SWIPE_BOT} [PASS]", flush=True)
    vp = (VIDEO_CMD[-3:] == ["tap", str(CX), str(TAP_Y)])
    print(f"  video pause/resume tap center [{('PASS' if vp else 'FAIL')}: {' '.join(VIDEO_CMD[-3:])}]", flush=True)
    if not vp: ok = False
    sf = scrcpy_at(0, 0)
    print(f"  scrcpy-window detect returns bool [{('PASS' if isinstance(sf, bool) else 'FAIL')}: {sf} at 0,0]", flush=True)
    if not isinstance(sf, bool): ok = False
    # SHIFT+wheel must fire NEXT even over the mirror: scrcpy makes it a horizontal scroll (Reels ignores it)
    calls, orig_run, orig_at = [], run_cmd, scrcpy_at
    globals()['run_cmd'] = lambda c: calls.append(c)
    globals()['scrcpy_at'] = lambda x, y: True
    globals()['shift_held'] = True; globals()['last_fire'] = 0.0
    on_scroll(10, 10, 0, -1)
    globals()['run_cmd'], globals()['scrcpy_at'] = orig_run, orig_at
    globals()['shift_held'] = False
    wok = (calls == [NEXT_CMD])
    print(f"  SHIFT+wheel over mirror -> NEXT [{('PASS' if wok else 'FAIL')}]", flush=True)
    if not wok: ok = False
    # SHIFT+click over the mirror must NOT fire: scrcpy already taps there (else double-tap cancels pause)
    calls2 = []
    globals()['run_cmd'] = lambda c: calls2.append(c)
    globals()['scrcpy_at'] = lambda x, y: True
    globals()['shift_held'] = True
    from pynput.mouse import Button as _B
    on_click(10, 10, _B.middle, True)
    globals()['run_cmd'], globals()['scrcpy_at'] = orig_run, orig_at
    globals()['shift_held'] = False
    cok = (calls2 == [])
    print(f"  SHIFT+click over mirror -> no double-tap [{('PASS' if cok else 'FAIL')}]", flush=True)
    if not cok: ok = False
    # plain wheel on the mirror screen = NEXT/PREV (suppressed from scrcpy); elsewhere passes through
    globals()['acc_dx'] = globals()['acc_dy'] = 0.0; globals()['acc_last'] = 0.0
    globals()['scrcpy_at'] = lambda x, y: True
    pd1 = wheel_decision(10, 10, False, 0, -10, now=50.0)
    globals()['acc_dx'] = globals()['acc_dy'] = 0.0
    pd3 = wheel_decision(10, 10, False, 0, 10, now=50.1)
    globals()['scrcpy_at'] = lambda x, y: False
    pd2 = wheel_decision(10, 10, False, 0, -10)
    pok = (pd1 == (True, "NEXT") and pd3 == (True, "PREV") and pd2 == (False, None))
    print(f"  plain wheel mirror=NEXT/PREV / elsewhere=on [{('PASS' if pok else 'FAIL')}]", flush=True)
    if not pok: ok = False
    # pynput fallback (Quartz tap unavailable): plain wheel on mirror also fires NEXT
    calls3 = []
    globals()['run_cmd'] = lambda c: calls3.append(c)
    globals()['scrcpy_at'] = lambda x, y: True
    globals()['shift_held'] = False; globals()['last_fire'] = 0.0
    on_scroll(10, 10, 0, -1)
    globals()['run_cmd'] = orig_run
    fok = (calls3 == [NEXT_CMD])
    print(f"  fallback plain wheel on mirror -> NEXT [{('PASS' if fok else 'FAIL')}]", flush=True)
    if not fok: ok = False
    # light scroll: three tiny -2px SHIFT+wheel ticks must add up to one NEXT
    globals()['acc_dx'] = globals()['acc_dy'] = 0.0; globals()['acc_last'] = 0.0
    acts = [wheel_decision(10, 10, True, 0, -2, now=100.0 + i * 0.05)[1] for i in range(3)]
    globals()['scrcpy_at'] = orig_at
    lok = (acts == [None, None, "NEXT"])
    print(f"  light SHIFT+wheel 3x-2px -> NEXT [{('PASS' if lok else 'FAIL')}: {acts}]", flush=True)
    if not lok: ok = False
    print("SELFTEST " + ("OK - DOWN=NEXT, UP=PREV" if ok else "FAILED"), flush=True)
    return ok

def run_cmd(cmd):
    try:
        r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=5)
        if r.returncode != 0:
            print(f"adb rc={r.returncode}: {(r.stderr or b'').decode(errors='replace').strip()}", flush=True)
        return r.returncode
    except Exception as e:
        print(f"adb error: {e}", flush=True)
        return -1

def fire(action, sync=True):
    global last_fire
    now = time.time()
    if now - last_fire < COOLDOWN: return False
    last_fire = now
    print(f"[{time.strftime('%H:%M:%S')}] wheel -> {action}", flush=True)
    cmd = NEXT_CMD if action == "NEXT" else PREV_CMD
    if sync: run_cmd(cmd)
    else: threading.Thread(target=run_cmd, args=(cmd,), daemon=True).start()
    return True

def accumulate_pixels(dx, dy, now=None):
    global acc_dx, acc_dy, acc_last
    if now is None: now = time.time()
    if now - acc_last > 0.35: acc_dx = acc_dy = 0.0
    acc_last = now; acc_dx += dx; acc_dy += dy
    if max(abs(acc_dx), abs(acc_dy)) < PIXEL_THRESHOLD: return None
    action = decide(acc_dx, acc_dy); acc_dx = acc_dy = 0.0
    return action

def wheel_decision(x, y, shift, dx, dy, now=None):
    """(suppress, action): SHIFT+wheel is ours everywhere (light, pixel-based);
    plain wheel while the cursor is on the mirror screen also steps NEXT/PREV;
    plain wheel elsewhere passes through to the Mac app unchanged."""
    if shift:
        return (True, accumulate_pixels(dx, dy, now=now))
    if scrcpy_at(x, y):
        return (True, accumulate_pixels(dx, dy, now=now))
    return (False, None)

def _quartz_cb(proxy, event_type, event, refcon):
    try:
        import Quartz
        if event_type in (Quartz.kCGEventTapDisabledByTimeout, Quartz.kCGEventTapDisabledByUserInput):
            if _tap is not None: Quartz.CGEventTapEnable(_tap, True)
            return event
        if event_type != Quartz.kCGEventScrollWheel: return event
        loc = Quartz.CGEventGetLocation(event); x, y = float(loc.x), float(loc.y)
        shift = bool(Quartz.CGEventGetFlags(event) & Quartz.kCGEventFlagMaskShift)
        pdx = Quartz.CGEventGetIntegerValueField(event, Quartz.kCGScrollWheelEventPointDeltaAxis2)
        pdy = Quartz.CGEventGetIntegerValueField(event, Quartz.kCGScrollWheelEventPointDeltaAxis1)
        if pdx == 0 and pdy == 0:
            pdx = Quartz.CGEventGetDoubleValueField(event, Quartz.kCGScrollWheelEventFixedPtDeltaAxis2)
            pdy = Quartz.CGEventGetDoubleValueField(event, Quartz.kCGScrollWheelEventFixedPtDeltaAxis1)
        suppress, action = wheel_decision(x, y, shift, float(pdx), float(pdy))
        if action: fire(action, sync=False)
        return None if suppress else event
    except Exception:
        return event

def preload_quartz():
    """Force PyObjC lazy imports to load single-threaded, before tap+pynput threads race on them."""
    try:
        import Quartz
        for n in ("CGEventGetLocation", "CGEventGetFlags", "CGEventGetIntegerValueField", "CGEventGetDoubleValueField", "CGEventTapEnable", "CGEventTapCreate", "CGEventMaskBit", "CFMachPortCreateRunLoopSource", "CFRunLoopAddSource", "CFRunLoopGetCurrent", "CFRunLoopRun", "CGWindowListCopyWindowInfo"):
            getattr(Quartz, n, None)
    except Exception:
        pass

def start_quartz_tap():
    preload_quartz()
    def _run():
        global _tap
        try:
            import Quartz
            mask = Quartz.CGEventMaskBit(Quartz.kCGEventScrollWheel)
            _tap = Quartz.CGEventTapCreate(Quartz.kCGSessionEventTap, Quartz.kCGHeadInsertEventTap, Quartz.kCGEventTapOptionDefault, mask, _quartz_cb, None)
            if not _tap:
                print("Quartz wheel tap unavailable - fallback to line scroll (allow Accessibility for Terminal)", flush=True); return
            src = Quartz.CFMachPortCreateRunLoopSource(None, _tap, 0)
            Quartz.CFRunLoopAddSource(Quartz.CFRunLoopGetCurrent(), src, Quartz.kCFRunLoopCommonModes)
            Quartz.CGEventTapEnable(_tap, True)
            print("Wheel tap ON: light SHIFT+wheel = NEXT/PREV | wheel on mirror screen = NEXT/PREV", flush=True)
            Quartz.CFRunLoopRun()
        except Exception as e:
            print(f"Quartz wheel tap failed ({e}) - fallback to line scroll", flush=True)
    threading.Thread(target=_run, daemon=True).start()

def on_scroll(x, y, dx, dy):
    global last_fire
    if not shift_held and not scrcpy_at(x, y): return
    # Fallback path (line deltas). Quartz tap above handles light/pixel scrolls and
    # suppresses these events when it is active; shared cooldown prevents double-fire.
    action = decide(dx, dy)
    if action is None: return
    fire(action)

def on_press(key):
    global shift_held
    try:
        from pynput.keyboard import Key
        if key in (Key.shift, Key.shift_l, Key.shift_r): shift_held = True
    except Exception: pass

def on_release(key):
    global shift_held
    try:
        from pynput.keyboard import Key
        if key in (Key.shift, Key.shift_l, Key.shift_r): shift_held = False
    except Exception: pass

def on_click(x, y, button, pressed):
    try:
        from pynput.mouse import Button
        name = str(button)
    except Exception:
        return
    if not pressed:
        return
    if scrcpy_at(x, y): return  # cursor over mirror: scrcpy handles click (SHIFT+click = tap there), else double-tap
    try:
        from pynput.mouse import Button
        if button in (Button.middle, Button.right):
            # always log so you can see if the hardware click is detected at all
            print(f"[{time.strftime('%H:%M:%S')}] {name} pressed shift={shift_held} -> " + ("VIDEO pause/resume" if shift_held else "ignored (hold SHIFT)"), flush=True)
            if shift_held:
                rc = run_cmd(VIDEO_CMD)
                if rc == 0:
                    print(f"[{time.strftime('%H:%M:%S')}] sent tap {CX} {TAP_Y} to {SERIAL or 'phone'}", flush=True)
    except Exception as e:
        print(f"click error: {e}", flush=True)

if __name__ == "__main__":
    if "--test" in sys.argv:
        print("== wheel selftest ==", flush=True)
        sys.exit(0 if selftest() else 1)
    if "--click-probe" in sys.argv:
        from pynput import mouse, keyboard
        print("CLICK-PROBE: press SHIFT+middle-click and SHIFT+right-click. Logging every middle/right press for 20s...", flush=True)
        import threading
        def stop():
            time.sleep(20)
            print("PROBE DONE - if no lines appeared, macOS blocked the listener or the mouse has no middle button (use SHIFT+right-click instead).", flush=True)
            os._exit(0)
        threading.Thread(target=stop, daemon=True).start()
        kl = keyboard.Listener(on_press=on_press, on_release=on_release)
        ml = mouse.Listener(on_scroll=on_scroll, on_click=on_click)
        kl.start(); ml.start()
        kl.join(); ml.join()
        sys.exit(0)
    from pynput import mouse, keyboard
    print("Hold SHIFT + wheel DOWN = NEXT | UP = PREV (light scroll ok) | SHIFT+middle-click (or SHIFT+right-click) = VIDEO pause/resume. Plain wheel while the cursor is on the mirror screen = NEXT/PREV too. Ctrl+C stops.", flush=True)
    start_quartz_tap()
    kl = keyboard.Listener(on_press=on_press, on_release=on_release)
    ml = mouse.Listener(on_scroll=on_scroll, on_click=on_click)
    kl.start(); ml.start()
    try: kl.join(); ml.join()
    except KeyboardInterrupt: print("\nStopped.", flush=True)
PYEOF
}

if [ "$1" = "--click-probe" ]; then
  write_python
  ensure_pynput
  [ -f "$IPFILE" ] && SAVED_IP=$(cat "$IPFILE") || SAVED_IP=""
  pick_serial; export ADB_SERIAL="$SERIAL"
  echo "Phone ($SERIAL). Probe logging clicks for 20s - try your middle-click now."
  "$PY" "$PYFILE" --click-probe
  exit $?
fi

if [ "$1" = "--test" ]; then
  echo "=== REVIEW (helper auto-written to $PYFILE) ==="
  write_python
  ensure_pynput
  "$PY" "$PYFILE" --test
  rc=$?
  "$ADB" devices -l 2>/dev/null | head -n 4
  exit $rc
fi

cd "$HOME" || exit 1
[ -x "$ADB" ] || brew install android-platform-tools
[ -x "$PY" ] || brew install python
ensure_pynput || { echo "Could not make pynput available (offline?). Fix $DIR/.venv, then retry."; exit 1; }
write_python

echo "=============================================="
echo " Reels SHIFT + WHEEL -> Samsung TV"
echo " SHIFT + wheel DOWN = NEXT | UP = PREV | SHIFT + middle/right-click = VIDEO pause/resume"
echo "=============================================="
echo "1) S25 FE + TV same WiFi, Smart View ON, Reels fullscreen, screen ON"
echo ""

connect_phone
echo ""; echo "Phone OK ($SERIAL)."
echo ""

echo "Checking macOS permission (one-time)..."
if ! check_trust; then
  echo ""
  echo "*** macOS blocked the wheel listener. Fix (1 min, once): ***"
  echo "1) I am opening Settings > Privacy > Input Monitoring for you."
  echo "2) Click +, add Terminal, turn it ON. Same in Accessibility."
  echo "3) FULLY quit Terminal (Cmd+Q), reopen, double-click this file again."
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_ListenEvent" 2>/dev/null
  sleep 1
  open "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility" 2>/dev/null
  echo "Tip: the pad in Android-Mouse.command needs no permission (clicks land in its own window)."
  read -p "Press Enter to close: " _
  exit 1
fi
echo "Permission OK. Starting listener..."
echo "Hold SHIFT + turn wheel. Ctrl+C to stop."
"$PY" "$PYFILE"
